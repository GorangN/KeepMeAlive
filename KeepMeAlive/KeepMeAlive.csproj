<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>KeepMeAlive.Program</StartupObject>
    <ApplicationIcon>Resources\Icons\tray_inactive.ico</ApplicationIcon>
    <AssemblyName>KeepMeAlive</AssemblyName>
    <RootNamespace>KeepMeAlive</RootNamespace>
    <Product>KeepMeAlive</Product>
    <Authors>GorangN</Authors>
    <Company>KeepMeAlive</Company>
    <Description>Privacy-first Windows keep-alive utility with portable and profile storage modes.</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\tray_active.ico"/>
    <Resource Include="Resources\Icons\tray_inactive.ico"/>
    <Resource Include="Resources\Fonts\Inter-Regular.ttf"/>
    <Resource Include="Resources\Fonts\Inter-Medium.ttf"/>
    <Resource Include="Resources\Fonts\Inter-SemiBold.ttf"/>
    <Resource Include="Resources\Fonts\Inter-Bold.ttf"/>
    <Resource Include="Resources\Fonts\Manrope-Variable.ttf"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="neon.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources/Icons/Tabler/LICENSE.txt" TargetPath="ThirdPartyNotices/Tabler-Icons.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="Models/**/*.cs;ViewModels/**/*.cs;Messages/**/*.cs;Services/**/*.cs;Helpers/Interop.cs" />
    <Compile Include="Services/DialogService.cs;Services/ThemeService.cs;Services/ShellService.cs" />
    <ProjectReference Include="../KeepMeAlive.Core/KeepMeAlive.Core.csproj" />
    <ProjectReference Include="../KeepMeAlive.Application/KeepMeAlive.Application.csproj" />
    <ProjectReference Include="../KeepMeAlive.Infrastructure/KeepMeAlive.Infrastructure.csproj" />
  </ItemGroup>
</Project>
