<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#F2F2F7</Color>
    <Color x:Key="SurfaceColor">#EDEFF5</Color>
    <Color x:Key="SurfaceContainerLowColor">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLowestColor">#F7F7FA</Color>
    <Color x:Key="SurfaceContainerColor">#E8E8EF</Color>
    <Color x:Key="SurfaceContainerHighColor">#DEDEE6</Color>
    <Color x:Key="SurfaceContainerHighestColor">#727278</Color>
    <Color x:Key="PrimaryColor">#0066CC</Color>
    <Color x:Key="PrimaryDimColor">#004F9E</Color>
    <Color x:Key="PrimaryContainerColor">#DCEBFF</Color>
    <Color x:Key="OnSurfaceColor">#1C1C1E</Color>
    <Color x:Key="OnSurfaceVariantColor">#636366</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OutlineVariantColor">#D1D1D8</Color>
    <Color x:Key="OutlineColor">#77777F</Color>
    <Color x:Key="ErrorColor">#B42318</Color>
    <Color x:Key="ErrorContainerColor">#FEE4E2</Color>
    <Color x:Key="RunningColor">#207A3D</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
