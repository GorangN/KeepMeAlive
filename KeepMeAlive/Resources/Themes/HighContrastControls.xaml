<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Text" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Gray1" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Gray2" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Gray" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.TextBlock.FloatingMessage" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Control.Border" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border.Focus" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border.MouseOver" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.Border.Focus" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.Border.MouseOver" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.ComboBox.PopupBorder" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Control.Background" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Control.Disabled" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Gray3" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Gray5" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Gray7" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Gray8" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Gray9" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Highlight" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent2" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent3" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent4" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.AccentBase" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Selected.Foreground" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.IdealForeground" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}"/>
    <DataTemplate x:Key="HighContrast.ContentText">
        <TextBlock Text="{Binding}" Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
    </DataTemplate>
    <Style x:Key="HighContrast.ComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}">
        <Setter Property="ContentTemplate" Value="{StaticResource HighContrast.ContentText}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        <Setter Property="mah:ItemHelper.HoverForegroundBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <Setter Property="mah:ItemHelper.DisabledSelectedBackgroundBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource HighContrast.ComboBoxItem}"/>
    <Style x:Key="HighContrast.CalendarDayButton" TargetType="CalendarDayButton" BasedOn="{StaticResource MahApps.Styles.CalendarDayButton}">
        <Setter Property="ContentTemplate" Value="{StaticResource HighContrast.ContentText}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HighContrast.CalendarButton" TargetType="CalendarButton" BasedOn="{StaticResource MahApps.Styles.CalendarButton}">
        <Setter Property="ContentTemplate" Value="{StaticResource HighContrast.ContentText}"/>
    </Style>
    <Style x:Key="HighContrast.CalendarHeader" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Calendar.Header}">
        <Setter Property="ContentTemplate" Value="{StaticResource HighContrast.ContentText}"/>
    </Style>
</ResourceDictionary>
