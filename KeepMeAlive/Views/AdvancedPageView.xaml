<UserControl x:Class="KeepMeAlive.Views.AdvancedPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:KeepMeAlive.Models;assembly=KeepMeAlive.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Text="Advanced" Style="{StaticResource PageHeadlineStyle}" Margin="0 0 0 48"/>
            <TextBlock Text="Activity method" Style="{StaticResource CardHeaderStyle}" Margin="0 0 0 8"/>
            <Border Style="{StaticResource SettingRowStyle}" Margin="0 0 0 4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                    <ContentControl Content="{StaticResource Tabler.Activity}" Style="{StaticResource TablerIconStyle}" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Simulation method" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="How KeepMeAlive signals activity." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <ComboBox Grid.Column="2" Style="{StaticResource ComboBoxStyle}" SelectedItem="{Binding SelectedMethod}" AutomationProperties.Name="Activity method" AutomationProperties.HelpText="Choose keyboard input or a small mouse movement." IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"><x:Static Member="models:KeepAliveMethod.Keyboard"/><x:Static Member="models:KeepAliveMethod.Mouse"/></ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Pulse interval" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Seconds between inputs. Minimum 20 seconds." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding IntervalSecondsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pulse interval in seconds" AutomationProperties.HelpText="Enter a number from 20 to 86400 seconds." IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>
                </Grid>
            </Border>
            <TextBlock Text="Input parameters" Style="{StaticResource CardHeaderStyle}" Margin="0 32 0 8"/>
            <Border Style="{StaticResource SettingRowStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedMethod}" Value="Keyboard"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Virtual key code" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Windows function key (default: 126 = F15)." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding VirtualKeyCodeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Virtual key code" AutomationProperties.HelpText="Enter a function-key code from 124 through 135, corresponding to F13 through F24." IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>
                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedMethod}" Value="Mouse"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Mouse pixel delta" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Pixels moved per pulse (default: 2 pixels)." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding MousePixelDeltaText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mouse movement in pixels" AutomationProperties.HelpText="Enter a distance from 1 through 5 pixels." IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding InputError}" Style="{StaticResource ValidationTextStyle}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0 12 0 0" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock Text="Changes apply when you start a session or save before leaving this page." Style="{StaticResource FooterTextStyle}" Margin="0 16 0 0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
