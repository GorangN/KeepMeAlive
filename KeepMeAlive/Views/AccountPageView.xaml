<UserControl x:Class="KeepMeAlive.Views.AccountPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32 28">
<TextBlock Text="Account" Style="{StaticResource PageHeadlineStyle}"/>
<TextBlock Text="Your account is optional. Keep-alive always works locally." Style="{StaticResource PageSubtitleStyle}" Margin="0 6 0 24"/>
<Border Style="{StaticResource CardSectionStyle}"><StackPanel>
<TextBlock Text="{Binding AccountStatus}" Style="{StaticResource CardHeaderStyle}" AutomationProperties.LiveSetting="Polite"/>
<TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0 12 0 20"/>
<WrapPanel>
<Button Content="_Sign in" Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanSignIn}" Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}" Margin="0 0 10 8"/>
<Button Content="Cancel sign-in" Command="{Binding CancelSignInCommand}" Style="{StaticResource GhostButtonStyle}" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0 0 10 8"/>
<Button Content="_Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0 0 10 8"/>
<Button Content="Sign _out" Command="{Binding SignOutCommand}" Style="{StaticResource GhostButtonStyle}" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0 0 0 8"/>
</WrapPanel>
<StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0 20 0 0">
<TextBlock Text="Display name" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 8"/>
<TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" MaxLength="100" AutomationProperties.Name="Account display name"/>
<TextBlock Text="{Binding Email}" Style="{StaticResource BodyTextStyle}" Margin="0 12 0 16"/>
<Button Content="Save profile" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
<Border Height="1" Background="{DynamicResource OutlineVariantBrush}" Margin="0 24"/>
<TextBlock Text="Subscription" Style="{StaticResource CardHeaderStyle}"/>
<TextBlock Text="{Binding LicenseAccessStatus}" Style="{StaticResource BodyTextStyle}" Margin="0 12 0 0"/>
<TextBlock Text="{Binding LicenseExpiryDisplay}" Style="{StaticResource SettingDescriptionStyle}" Margin="0 6 0 0"/>
<TextBlock Text="{Binding LastSyncedDisplay, StringFormat='Last successful sync: {0}'}" Style="{StaticResource FooterTextStyle}" Margin="0 20 0 0"/>
</StackPanel>
</StackPanel></Border>
<TextBlock Text="Sign-in opens your browser. Session credentials are protected by Windows; your input activity and local settings stay on this PC." Style="{StaticResource FooterTextStyle}" Margin="0 20 0 0"/>
</StackPanel></ScrollViewer></UserControl>
