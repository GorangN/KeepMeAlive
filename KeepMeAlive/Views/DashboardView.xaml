<UserControl x:Class="KeepMeAlive.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:KeepMeAlive.Models;assembly=KeepMeAlive.Core"
             xmlns:controls="clr-namespace:KeepMeAlive.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageContentStyle}" DataContext="{Binding DashboardViewModel}">
            <Border Style="{StaticResource TimerCardStyle}" MaxWidth="396" HorizontalAlignment="Center" Width="396" Margin="0 8 0 12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                    <Grid Grid.Row="1" Width="210" Height="210" Margin="0 16 0 16">
                        <controls:PulseRing Value="{Binding PulseProgress}">
                            <controls:PulseRing.Style><Style TargetType="controls:PulseRing"><Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasPulseCountdown}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></controls:PulseRing.Style>
                        </controls:PulseRing>
                        <TextBlock Text="{Binding PulseCountdownDisplay}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Next input countdown">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"><Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasPulseCountdown}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                        <Button Command="{Binding StartCommand}" Style="{StaticResource RoundActionButtonStyle}" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}" ToolTip="Start keep-alive" AutomationProperties.Name="Start keep-alive"><ContentControl Content="{StaticResource Tabler.PlayerPlay}" Style="{StaticResource TablerIconStyle}" Width="18" Height="18"/></Button>
                        <Button Command="{Binding StopCommand}" Style="{StaticResource RoundActionButtonStyle}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Stop keep-alive" AutomationProperties.Name="Stop keep-alive"><ContentControl Content="{StaticResource Tabler.PlayerStop}" Style="{StaticResource TablerIconStyle}" Width="18" Height="18"/></Button>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Text="{Binding NextPulseDisplay}" Style="{StaticResource SettingDescriptionStyle}" HorizontalAlignment="Center" Margin="0 0 0 16"/>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationTextStyle}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock Text="{Binding InputError}" Style="{StaticResource ValidationTextStyle}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            <Border Style="{StaticResource SettingRowStyle}" Margin="0 0 0 4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Activity method" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="How this PC stays active." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}" SelectedItem="{Binding SelectedMethod}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" AutomationProperties.Name="Activity method"><x:Static Member="models:KeepAliveMethod.Keyboard"/><x:Static Member="models:KeepAliveMethod.Mouse"/></ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}" Margin="0 0 0 4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Pulse interval" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Seconds between inputs, with a small variation." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding IntervalSecondsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource InputStyle}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" AutomationProperties.Name="Pulse interval in seconds"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Keep display awake" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Prevent display and system sleep during a session." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding KeepAwakeEnabled}" Style="{StaticResource ToggleCheckBoxStyle}" AutomationProperties.Name="Keep display and system awake"/>
                </Grid>
            </Border>
            <TextBlock Text="{Binding IdleTimeDisplay}" Style="{StaticResource FooterTextStyle}" Margin="0 20 0 6"/>
            <TextBlock Text="Locked sessions pause automatically." Style="{StaticResource FooterTextStyle}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
