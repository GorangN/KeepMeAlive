<UserControl x:Class="KeepMeAlive.Views.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="32">
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="16 0 0 0" VerticalAlignment="Center">
            <ContentControl Content="{StaticResource Tabler.Activity}" Style="{StaticResource TablerIconStyle}" Width="16" Height="16" Margin="0 0 12 0"/>
            <TextBlock Text="KeepMeAlive" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource IconButtonStyle}" Width="46" Height="32" Command="{Binding MinimizeWindowCommand}" ToolTip="Minimize" AutomationProperties.Name="Minimize window"><ContentControl Style="{StaticResource TablerIconStyle}" Content="{StaticResource Tabler.Minus}" Width="14" Height="14"/></Button>
            <Button Style="{StaticResource IconButtonStyle}" Width="46" Height="32" Command="{Binding ToggleMaximizeCommand}" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore window"><ContentControl Style="{StaticResource TablerIconStyle}" Content="{StaticResource Tabler.Square}" Width="12" Height="12"/></Button>
            <Button Style="{StaticResource IconButtonStyle}" Width="46" Height="32" Command="{Binding HideWindowCommand}" ToolTip="Close to tray" AutomationProperties.Name="Close to tray"><ContentControl Style="{StaticResource TablerIconStyle}" Content="{StaticResource Tabler.X}" Width="14" Height="14"/></Button>
        </StackPanel>
    </Grid>
</UserControl>
