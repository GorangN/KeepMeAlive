<UserControl x:Class="KeepMeAlive.Views.TitleBarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="44">
<Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0 0 0 1"><Grid Margin="20 0 6 0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="KeepMeAlive" Style="{StaticResource AppTitleStyle}" VerticalAlignment="Center"/>
<StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
<Button Style="{StaticResource IconButtonStyle}" Command="{Binding MinimizeWindowCommand}" ToolTip="Minimize" AutomationProperties.Name="Minimize window"><ContentControl Style="{StaticResource TablerIconStyle}" Content="{StaticResource Tabler.Minus}" Width="16" Height="16"/></Button>
<Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleMaximizeCommand}" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore window"><ContentControl Style="{StaticResource TablerIconStyle}" Content="{StaticResource Tabler.Square}" Width="16" Height="16"/></Button>
<Button Style="{StaticResource IconButtonStyle}" Command="{Binding HideWindowCommand}" ToolTip="Close to tray" AutomationProperties.Name="Close to tray"><ContentControl Style="{StaticResource TablerIconStyle}" Content="{StaticResource Tabler.X}" Width="16" Height="16"/></Button>
</StackPanel></Grid></Border></UserControl>
