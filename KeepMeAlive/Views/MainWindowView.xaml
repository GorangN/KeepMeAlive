<Window x:Class="KeepMeAlive.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:KeepMeAlive.Models;assembly=KeepMeAlive.Core"
        xmlns:views="clr-namespace:KeepMeAlive.Views"
        Title="KeepMeAlive" Width="1020" Height="680" MinWidth="860" MinHeight="580"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource OnSurfaceBrush}" FontFamily="{DynamicResource UiFont}">
    <Window.InputBindings>
        <KeyBinding Key="Q" Modifiers="Alt" Command="{Binding ExitApplicationCommand}"/>
    </Window.InputBindings>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource ChromeBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0 0 1 0"/>
        <views:TitleBarView Grid.ColumnSpan="2"/>
        <DockPanel Grid.Row="1" Margin="4 8 4 4">
            <StackPanel DockPanel.Dock="Bottom">
                <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Account}" AutomationProperties.Name="Account" Margin="0 2">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Account"><Setter Property="Tag" Value="Selected"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <ContentControl Content="{StaticResource Tabler.UserCircle}" Style="{StaticResource TablerIconStyle}" Width="24" Height="24"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12 0 0 0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"><Setter Property="Text" Value="Account"/><Style.Triggers><DataTrigger Binding="{Binding AccountViewModel.IsSignedIn}" Value="True"><Setter Property="Text" Value="{Binding AccountViewModel.DisplayName}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Settings}" AutomationProperties.Name="Settings" Margin="0 2">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Settings"><Setter Property="Tag" Value="Selected"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Tabler.Settings}" Style="{StaticResource TablerIconStyle}" Margin="7 0 19 0"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Dashboard}" AutomationProperties.Name="Dashboard" Margin="0 2">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard"><Setter Property="Tag" Value="Selected"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Tabler.Activity}" Style="{StaticResource TablerIconStyle}" Margin="7 0 19 0"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Scheduling}" AutomationProperties.Name="Scheduling" Margin="0 2">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Scheduling"><Setter Property="Tag" Value="Selected"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Tabler.CalendarTime}" Style="{StaticResource TablerIconStyle}" Margin="7 0 19 0"/><TextBlock Text="Scheduling" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Advanced}" AutomationProperties.Name="Advanced" Margin="0 2">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Advanced"><Setter Property="Tag" Value="Selected"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Orientation="Horizontal"><ContentControl Content="{StaticResource Tabler.AdjustmentsHorizontal}" Style="{StaticResource TablerIconStyle}" Margin="7 0 19 0"/><TextBlock Text="Advanced" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <views:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource NavPageVisConverter}, ConverterParameter=Dashboard}"/>
            <views:SchedulingPageView DataContext="{Binding SettingsViewModel}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NavPageVisConverter}, ConverterParameter=Scheduling}"/>
            <views:AdvancedPageView DataContext="{Binding DashboardViewModel}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NavPageVisConverter}, ConverterParameter=Advanced}"/>
            <views:AccountPageView DataContext="{Binding AccountViewModel}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NavPageVisConverter}, ConverterParameter=Account}"/>
            <views:SettingsPageView Visibility="{Binding CurrentPage, Converter={StaticResource NavPageVisConverter}, ConverterParameter=Settings}"/>
        </Grid>
    </Grid>
</Window>
