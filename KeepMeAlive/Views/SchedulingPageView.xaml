<UserControl x:Class="KeepMeAlive.Views.SchedulingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:KeepMeAlive.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Text="Scheduling" Style="{StaticResource PageHeadlineStyle}" Margin="0 0 0 48"/>
            <TextBlock Text="One-time action" Style="{StaticResource CardHeaderStyle}" Margin="0 0 0 8"/>
            <Border Style="{StaticResource SettingRowStyle}" Margin="0 0 0 4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentControl Content="{StaticResource Tabler.CalendarTime}" Style="{StaticResource TablerIconStyle}" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Scheduled action" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Changes take effect when you save." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding ScheduledActionEnabled}" Style="{StaticResource ToggleCheckBoxStyle}" AutomationProperties.Name="Enable scheduled action"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}" Margin="0 0 0 4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Action" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Choose what this PC should do." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableScheduledActions}" SelectedItem="{Binding SelectedScheduledAction}" IsEnabled="{Binding ScheduledActionEnabled}" Style="{StaticResource ComboBoxStyle}" AutomationProperties.Name="System action"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}" Margin="0 0 0 4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Date" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Choose a date from the calendar." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding ScheduledDate}" IsEnabled="{Binding ScheduledActionEnabled}" behaviors:CalendarOnlyDatePicker.IsCalendarOnly="True" MinHeight="32" VerticalAlignment="Center" AutomationProperties.Name="Scheduled date" AutomationProperties.HelpText="Choose the date from the calendar. Press Alt+Down to open it."/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0 0 16 0"><TextBlock Text="Time" Style="{StaticResource SettingLabelStyle}"/><TextBlock Text="Local time in 24-hour format (HH:mm)." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" IsEnabled="{Binding ScheduledActionEnabled}" AutomationProperties.Name="Scheduled local time, hours and minutes"/>
                </Grid>
            </Border>
            <TextBlock Text="{Binding ScheduleStatus}" Style="{StaticResource BodyTextStyle}" Margin="0 20 0 0" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationTextStyle}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0 8 0 0" AutomationProperties.LiveSetting="Assertive"/>
            <WrapPanel Margin="0 16 0 0"><Button Content="_Save schedule" Command="{Binding SaveCommand}" Style="{StaticResource SaveButtonStyle}" Margin="0 0 8 8"/><Button Content="_Discard" Command="{Binding DiscardCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0 0 0 8"/></WrapPanel>
            <TextBlock Text="Missed actions are skipped; ambiguous daylight-saving times must be changed." Style="{StaticResource FooterTextStyle}" Margin="0 16 0 8"/>
            <TextBlock Text="Shutdown and restart can close applications. Save your work before the scheduled time." Style="{StaticResource FooterTextStyle}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
