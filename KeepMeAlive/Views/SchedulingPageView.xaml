<UserControl x:Class="KeepMeAlive.Views.SchedulingPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:KeepMeAlive.Behaviors">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32 28">
<TextBlock Text="Scheduling" Style="{StaticResource PageHeadlineStyle}"/>
<TextBlock Text="Set a one-time action for this PC." Style="{StaticResource PageSubtitleStyle}" Margin="0 6 0 24"/>
<Border Style="{StaticResource CardSectionStyle}"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Scheduled action" Style="{StaticResource CardHeaderStyle}"/><TextBlock Text="Changes take effect when you save." Style="{StaticResource SettingDescriptionStyle}"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding ScheduledActionEnabled}" Style="{StaticResource ToggleCheckBoxStyle}" AutomationProperties.Name="Enable scheduled action"/></Grid>
<TextBlock Text="Action" Style="{StaticResource FieldLabelStyle}" Margin="0 24 0 8"/>
<ComboBox ItemsSource="{Binding AvailableScheduledActions}" SelectedItem="{Binding SelectedScheduledAction}" IsEnabled="{Binding ScheduledActionEnabled}" Style="{StaticResource ComboBoxStyle}" AutomationProperties.Name="System action"/>
<Grid Margin="0 20 0 0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 8"/><DatePicker SelectedDate="{Binding ScheduledDate}" IsEnabled="{Binding ScheduledActionEnabled}" behaviors:CalendarOnlyDatePicker.IsCalendarOnly="True" MinHeight="38" AutomationProperties.Name="Scheduled date" AutomationProperties.HelpText="Choose the date from the calendar. Press Alt+Down to open it."/><TextBlock Text="Choose a date from the calendar." Style="{StaticResource SettingDescriptionStyle}" Margin="0 6 0 0"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Time (24-hour)" Style="{StaticResource FieldLabelStyle}" Margin="0 0 0 8"/><TextBox Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" IsEnabled="{Binding ScheduledActionEnabled}" AutomationProperties.Name="Scheduled local time, hours and minutes"/></StackPanel>
</Grid>
<TextBlock Text="Uses this PC's local time. Missed actions are skipped; ambiguous daylight-saving times must be changed." Style="{StaticResource SettingDescriptionStyle}" Margin="0 16 0 0"/>
<TextBlock Text="{Binding ScheduleStatus}" Style="{StaticResource BodyTextStyle}" Margin="0 20 0 0" AutomationProperties.LiveSetting="Polite"/>
<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0 14 0 0" AutomationProperties.LiveSetting="Assertive"/>
<WrapPanel Margin="0 24 0 0"><Button Content="_Save schedule" Command="{Binding SaveCommand}" Style="{StaticResource SaveButtonStyle}" Margin="0 0 10 0"/><Button Content="_Discard" Command="{Binding DiscardCommand}" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
</StackPanel></Border>
<TextBlock Text="Shutdown and restart can close applications. Save your work before the scheduled time." Style="{StaticResource FooterTextStyle}" Margin="0 20 0 0"/>
</StackPanel></ScrollViewer></UserControl>
